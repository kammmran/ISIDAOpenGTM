  object ChGTMLatent: TChart
    AnchorSideLeft.Control = BtXML
    AnchorSideLeft.Side = asrBottom
    AnchorSideTop.Control = Owner
    AnchorSideRight.Control = Owner
    AnchorSideRight.Side = asrBottom
    AnchorSideBottom.Control = CGPlots
    Left = 449
    Height = 450
    Top = 10
    Width = 760
    AllowZoom = False
    AxisList = <    
      item
        Grid.Visible = False
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Title.LabelFont.Orientation = 900
        Title.LabelBrush.Style = bsClear
      end    
      item
        Grid.Visible = False
        Alignment = calBottom
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Title.LabelBrush.Style = bsClear
      end>
    BackColor = clWhite
    Foot.Brush.Color = clBtnFace
    Foot.Font.Color = clBlue
    Proportional = True
    Title.Brush.Color = clBtnFace
    Title.Font.Color = clBlue
    Title.Text.Strings = (
      'TAChart'
    )
    Toolset = CTSMols
    Anchors = [akTop, akLeft, akRight, akBottom]
    BorderSpacing.Left = 10
    BorderSpacing.Top = 10
    BorderSpacing.Right = 10
    BorderSpacing.Bottom = 10
    object LBMols: TBubbleSeries
      Active = False
      Title = 'Projections'
      OverrideColor = [bocBrush]
      Source = LCSMols
    end
    object LSTraits: TLineSeries
      Active = False
      Title = 'Traits'
      LineType = ltNone
      Pointer.Visible = True
      ShowPoints = True
      Source = LCSTraits
    end
    object LBNodes: TBubbleSeries
      Active = False
      Title = 'Nodes'
      OverrideColor = [bocBrush]
      Source = LCSResp
    end
    object LSEmphasize: TLineSeries
      Active = False
      Title = 'Current molecule'
      ZPosition = 1
      LinePen.Color = clNavy
      LineType = ltNone
      Pointer.Brush.Color = clNavy
      Pointer.Style = psCircle
      Pointer.Visible = True
      ShowPoints = True
      Source = LCSEmphasize
    end
    object LBSamples: TBubbleSeries
      Active = False
      Title = 'Responsibilities'
      Source = LCSSamples
    end
  end
