<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="GTMClass"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units>
      <Unit>
        <Filename Value="GTMClass.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="gtmc_option.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../GTMapTool/ugtm_options.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../GTMapTool/ugtmbase.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../GTMapTool/ugtmxml.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../../ISIDAKernel/dmath/units/ulinalg.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../../ISIDAKernel/dmath/units/utypes.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../../ISIDAKernel/isida_descriptor.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="../../ModelAnalyzerR/unitclsstat.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UnitClsStat"/>
      </Unit>
      <Unit>
        <Filename Value="../../ModelAnalyzerR/unitcvsvm.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UnitCVsvm"/>
      </Unit>
      <Unit>
        <Filename Value="ugtmclass.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UGTMClass"/>
      </Unit>
      <Unit>
        <Filename Value="../../ModelAnalyzerC/unitclsstats.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UnitClsStats"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="GTMClass"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="../GTMapTool;../../ISIDAKernel/dmath/units;../../ISIDAKernel;../../ModelAnalyzerR;../../ModelAnalyzerC"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf2Set"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
