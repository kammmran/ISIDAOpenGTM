#!/bin/sh
# Linker shim used when building ISIDA/GTM with Free Pascal 3.2.x on recent macOS.
#
# Apple's current linker rejects the Objective-C method lists that FPC 3.2.x
# emits for the Cocoa widgetset ("ld: malformed method list atom ... fixups
# found beyond the number of method entries"), and the old "-ld_classic"
# escape hatch has been removed. LLVM's Mach-O linker (ld64.lld) accepts them.
#
# Free Pascal is pointed at this directory with -FD<dir>, so it runs this
# script as "ld". The script forwards everything to ld64.lld and converts the
# legacy -macosx_version_min flag that FPC passes into lld's -platform_version.
#
# Install lld with:  brew install lld

find_lld() {
  if [ -n "${GTM_LLD:-}" ] && [ -x "$GTM_LLD" ]; then echo "$GTM_LLD"; return; fi
  for c in ld64.lld \
           /opt/homebrew/opt/lld/bin/ld64.lld /usr/local/opt/lld/bin/ld64.lld \
           /opt/homebrew/opt/llvm/bin/ld64.lld /usr/local/opt/llvm/bin/ld64.lld; do
    p=$(command -v "$c" 2>/dev/null) && { echo "$p"; return; }
  done
}

LLD=$(find_lld)
if [ -z "$LLD" ]; then
  echo "macos/linker/ld: ld64.lld not found. Install it with 'brew install lld' or set GTM_LLD." >&2
  exit 1
fi

SDKVER=$(xcrun --show-sdk-version 2>/dev/null)
[ -n "$SDKVER" ] || SDKVER=14.0
MIN=11.0

# Rebuild the argument list without the version-min flag and its value.
n=$#
i=0
skip=0
for a in "$@"; do
  i=$((i + 1))
  if [ $skip -eq 1 ]; then MIN=$a; skip=0; continue; fi
  case "$a" in
    -macosx_version_min|-macos_version_min) skip=1; continue ;;
  esac
  set -- "$@" "$a"
done
shift "$n"

exec "$LLD" "$@" -platform_version macos "$MIN" "$SDKVER"
